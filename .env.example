# Copy to `.env` in the repo root (gitignored). Every key is optional: without keys everything
# still builds and all unit tests pass; the features below fall back as noted.
#
# Read by:  android/app/build.gradle.kts (Safe Browsing key only, baked into the APK's BuildConfig)
#           backend/docker-compose.yml   (env_file: ../.env)

# Cloud analysis (backend). Empty -> the Opus step is skipped and the trace says so.
ANTHROPIC_API_KEY=

# Google Safe Browsing v5. Empty -> Safe Browsing stub (gate keeps working without it).
# WARNING: this key is compiled into every APK you build. Restrict it in Google Cloud Console
# (API restriction: Safe Browsing API only; application restriction: Android app dev.redflag.app
# + your signing cert SHA-1). For APKs you hand out, build with -Predflag.noSbKey.
GOOGLE_CLOUD_API_KEY=

# --- other backend knobs ---
# Defaults and the full list: backend/redflag_backend/config.py. With docker compose, DEMO_MODE,
# SAFE_BROWSING_MODE, REDFLAG_MODEL, REDFLAG_EFFORT, REDFLAG_DAILY_OPUS_CAP and REDFLAG_WALL_CLOCK_S
# are set by the compose `environment:` block, so pass them on the command line instead of here:
#   cd backend && DEMO_MODE=1 SAFE_BROWSING_MODE=stub docker compose up -d --build
# Knobs compose does not set (e.g. SAFE_BROWSING_ANDROID_CERT, the SHA-1 your Android-restricted
# key is bound to) can go in this file.
# SAFE_BROWSING_ANDROID_CERT=
