  "safe_browsing_stub": {
    "doc": "Default Safe Browsing provider (no API key). A URL is a hit if its normalized form (scheme dropped, host lowercased) starts with one of url_prefixes, or its registrable_domain is in domains. url_prefixes are Google's official test pages (testsafebrowsing.appspot.com) + demo malicious hosts.",
    "url_prefixes": [
      "testsafebrowsing.appspot.com/s/phishing.html",
      "testsafebrowsing.appspot.com/s/malware.html",
      "testsafebrowsing.appspot.com/s/malware_in_iframe.html",
      "testsafebrowsing.appspot.com/s/unwanted.html",
      "testsafebrowsing.appspot.com/s/bad_login.html",
      "testsafebrowsing.appspot.com/apiv4/"
    ],
    "domains": [
      "free-gift-claim-sg.top"
    ]
  },
  "confusables": {
    "doc": "Latin look-alikes. homoglyph = some non-ASCII host label becomes pure [a-z0-9-] after mapping each char through this table, OR a label mixes Latin [a-z] with Cyrillic (U+0400-U+04FF) or Greek (U+0370-U+03FF) letters.",
    "map": {
      "а": "a",
      "е": "e",
      "о": "o",
      "р": "p",
      "с": "c",
      "у": "y",
      "х": "x",
