{
  "version": 1,
  "doc": "In-app link check: links found in pasted/shared text (docs/plans/manual_url_check.md §2). Implemented by android/core UrlExtractor (the cloud receives one chosen URL, so there is no Python twin). urls = links as written, re-armed, https:// added when schemeless; message = the whole trimmed text when it holds >= 2 letters/digits outside the links, else null. window vectors: messageWindow(text, url, limit).",
  "vectors": [
    {"id": "plain_https", "text": "https://safepay-escrow.shop/pay", "expect": {"urls": ["https://safepay-escrow.shop/pay"], "message": null, "defanged": false}},
    {"id": "plain_http_ip_port", "text": "http://192.168.0.24:8081/usedtrade/", "expect": {"urls": ["http://192.168.0.24:8081/usedtrade/"], "message": null, "defanged": false}},
    {"id": "schemeless_bare", "text": "safepay-escrow.shop/pay?id=7", "expect": {"urls": ["https://safepay-escrow.shop/pay?id=7"], "message": null, "defanged": false}},
    {"id": "www_bare", "text": "www.redelivery-center.com", "expect": {"urls": ["https://www.redelivery-center.com"], "message": null, "defanged": false}},
    {"id": "sms_web_balsin", "text": "[Web발신]\n[CJ대한통운] 고객님 택배가 주소불명으로 보관중입니다. 주소 수정 https://redelivery-center.com/r/8812", "expect": {"urls": ["https://redelivery-center.com/r/8812"], "message": "[Web발신]\n[CJ대한통운] 고객님 택배가 주소불명으로 보관중입니다. 주소 수정 https://redelivery-center.com/r/8812", "defanged": false}},
    {"id": "korean_after_path", "text": "https://abc.kr/x에서 확인하세요", "expect": {"urls": ["https://abc.kr/x"], "message": "https://abc.kr/x에서 확인하세요", "defanged": false}},
    {"id": "korean_after_host", "text": "https://abc.kr에서 확인", "expect": {"urls": ["https://abc.kr"], "message": "https://abc.kr에서 확인", "defanged": false}},
    {"id": "korean_before_bare", "text": "택배조회abc-track.com/q 눌러주세요", "expect": {"urls": ["https://abc-track.com/q"], "message": "택배조회abc-track.com/q 눌러주세요", "defanged": false}},
    {"id": "korean_after_bare_host", "text": "abc-track.com에서 조회", "expect": {"urls": ["https://abc-track.com"], "message": "abc-track.com에서 조회", "defanged": false}},
    {"id": "idn_host_with_scheme", "text": "https://네이버.com/login", "expect": {"urls": ["https://네이버.com/login"], "message": null, "defanged": false}},
    {"id": "arrow_symbol_after", "text": "확인▶https://a-pay.shop/p◀", "expect": {"urls": ["https://a-pay.shop/p"], "message": "확인▶https://a-pay.shop/p◀", "defanged": false}},
    {"id": "trailing_period", "text": "Visit https://example.org/path.", "expect": {"urls": ["https://example.org/path"], "message": "Visit https://example.org/path.", "defanged": false}},
    {"id": "trailing_comma_question", "text": "이거 https://a.example.com/x?, 맞아요?", "expect": {"urls": ["https://a.example.com/x"], "message": "이거 https://a.example.com/x?, 맞아요?", "defanged": false}},
    {"id": "parenthesized", "text": "(https://a.example.com/p).", "expect": {"urls": ["https://a.example.com/p"], "message": null, "defanged": false}},
    {"id": "balanced_parens_kept", "text": "https://en.wikipedia.org/wiki/Foo_(bar)", "expect": {"urls": ["https://en.wikipedia.org/wiki/Foo_(bar)"], "message": null, "defanged": false}},
    {"id": "angle_brackets", "text": "<https://a.example.com/x>", "expect": {"urls": ["https://a.example.com/x"], "message": null, "defanged": false}},
    {"id": "markdown_link", "text": "[여기](https://a.example.com/x)", "expect": {"urls": ["https://a.example.com/x"], "message": "[여기](https://a.example.com/x)", "defanged": false}},
    {"id": "quoted", "text": "\"https://a.example.com/x\"", "expect": {"urls": ["https://a.example.com/x"], "message": null, "defanged": false}},
    {"id": "corner_brackets", "text": "「https://a.example.com/x」", "expect": {"urls": ["https://a.example.com/x"], "message": null, "defanged": false}},
    {"id": "defanged_hxxps_brackets", "text": "hxxps://evil-login[.]com/verify", "expect": {"urls": ["https://evil-login.com/verify"], "message": null, "defanged": true}},
    {"id": "defanged_paren_dot", "text": "evil-login(.)com/verify 조심", "expect": {"urls": ["https://evil-login.com/verify"], "message": "evil-login(.)com/verify 조심", "defanged": true}},
    {"id": "defanged_dot_word", "text": "hxxp://evil-login[dot]com", "expect": {"urls": ["http://evil-login.com"], "message": null, "defanged": true}},
    {"id": "two_links_order", "text": "판매자: 안전결제 https://bit.ly/3xYz 또는 safepay-escrow.shop/pay 로 해주세요", "expect": {"urls": ["https://bit.ly/3xYz", "https://safepay-escrow.shop/pay"], "message": "판매자: 안전결제 https://bit.ly/3xYz 또는 safepay-escrow.shop/pay 로 해주세요", "defanged": false}},
    {"id": "duplicate_normalized", "text": "https://A.Example.com/x https://a.example.com/x", "expect": {"urls": ["https://A.Example.com/x"], "message": null, "defanged": false}},
    {"id": "max_five", "text": "a1.com a2.com a3.com a4.com a5.com a6.com", "expect": {"urls": ["https://a1.com", "https://a2.com", "https://a3.com", "https://a4.com", "https://a5.com"], "message": null, "defanged": false}},
    {"id": "number_not_link", "text": "3.5배 수익 보장", "expect": {"urls": [], "message": null, "defanged": false}},
    {"id": "version_not_link", "text": "v1.2.3 업데이트", "expect": {"urls": [], "message": null, "defanged": false}},
    {"id": "file_name_not_link", "text": "photo.jpg 보냈어요", "expect": {"urls": [], "message": null, "defanged": false}},
    {"id": "email_not_link", "text": "문의: help.desk@gmail.com", "expect": {"urls": [], "message": null, "defanged": false}},
    {"id": "javascript_scheme", "text": "javascript:alert(1)", "expect": {"urls": [], "message": null, "defanged": false}},
    {"id": "intent_scheme", "text": "intent://scan.example.com/#Intent;scheme=zxing;end", "expect": {"urls": [], "message": null, "defanged": false}},
    {"id": "ftp_scheme", "text": "ftp://files.example.com/a", "expect": {"urls": [], "message": null, "defanged": false}},
    {"id": "loopback", "text": "http://127.0.0.1:8080/admin", "expect": {"urls": [], "message": null, "defanged": false}},
    {"id": "localhost", "text": "http://localhost:3000/", "expect": {"urls": [], "message": null, "defanged": false}},
    {"id": "link_local", "text": "http://169.254.169.254/latest/meta-data", "expect": {"urls": [], "message": null, "defanged": false}},
    {"id": "private_lan_kept", "text": "http://10.0.0.5/pay", "expect": {"urls": ["http://10.0.0.5/pay"], "message": null, "defanged": false}},
    {"id": "no_link_text", "text": "안녕하세요 엄마 폰 액정이 깨져서 이 번호로 연락해", "expect": {"urls": [], "message": null, "defanged": false}},
    {"id": "empty", "text": "   ", "expect": {"urls": [], "message": null, "defanged": false}},
    {"id": "uppercase_scheme", "text": "HTTPS://Pay-Check.SHOP/A", "expect": {"urls": ["HTTPS://Pay-Check.SHOP/A"], "message": null, "defanged": false}},
    {"id": "kakao_newline_after", "text": "링크\nhttps://open.kakao.com/o/abc\n들어와", "expect": {"urls": ["https://open.kakao.com/o/abc"], "message": "링크\nhttps://open.kakao.com/o/abc\n들어와", "defanged": false}},
    {"id": "fullwidth_space_after", "text": "https://a.example.com/x　확인", "expect": {"urls": ["https://a.example.com/x"], "message": "https://a.example.com/x　확인", "defanged": false}},
    {"id": "ellipsis_after", "text": "https://a.example.com/x…", "expect": {"urls": ["https://a.example.com/x"], "message": null, "defanged": false}}
  ],
  "window_vectors": [
    {"id": "short_text_unchanged", "text": "주소 수정 https://a.com/r", "url": "https://a.com/r", "limit": 300, "expect": "주소 수정 https://a.com/r"},
    {"id": "window_around_link", "text": "0123456789abcdefghij https://zz.com/p klmnopqrstuvwxyz", "url": "https://zz.com/p", "limit": 30, "expect": "bcdefghij https://zz.com/p klm"},
    {"id": "window_at_start", "text": "https://zz.com/p and a long tail of text here", "url": "https://zz.com/p", "limit": 20, "expect": "https://zz.com/p and"}
  ]
}
