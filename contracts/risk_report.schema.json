{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redflag.dev/contracts/risk_report.schema.json",
  "title": "RiskReport",
  "description": "The single report shape shared by Lite (on-device) and Cloud (backend). Score/level/red_flags are always produced by the rule engine (contracts/scoring_rules.json), never by a model.",
  "type": "object",
  "$defs": {
    "i18n": {
      "type": "object",
      "properties": {
        "en": { "type": "string" },
        "ko": { "type": "string" }
      },
      "required": ["en", "ko"],
      "additionalProperties": false
    },
    "level": { "type": "string", "enum": ["safe", "caution", "danger", "critical"] },
    "red_flag": {
      "type": "object",
      "properties": {
        "rule_id": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "source": { "type": "string", "enum": ["rule", "gemma+rule", "opus+rule", "signal+rule"] },
        "weight": { "type": "integer" },
        "title": { "$ref": "#/$defs/i18n" },
        "evidence": { "type": ["string", "null"] }
      },
      "required": ["rule_id", "severity", "source", "title", "evidence"],
      "additionalProperties": false
    },
    "form_signal": {
      "type": "object",
      "properties": {
        "action_domain": { "type": ["string", "null"] },
        "same_site": { "type": "boolean" },
        "sensitive_fields": {
          "type": "array",
          "items": { "type": "string", "enum": ["password", "card", "secret"] }
        }
      },
      "required": ["action_domain", "same_site", "sensitive_fields"],
      "additionalProperties": false
    },
    "trace_step": {
      "type": "object",
      "properties": {
        "t_ms": { "type": "integer", "minimum": 0 },
        "step": { "type": "string" },
        "detail": { "type": "string" }
      },
      "required": ["t_ms", "step", "detail"],
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": { "const": "1" },
    "id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["lite", "cloud"] },
    "status": {
      "type": "string",
      "enum": ["complete", "timeout", "error"],
      "description": "timeout/error = the model step did not finish; score is from deterministic signals only and the UI shows the 'could not verify' caution screen."
    },
    "url": { "type": "string" },
    "final_url": { "type": "string" },
    "registrable_domain": { "type": ["string", "null"] },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "level": { "$ref": "#/$defs/level" },
    "escalate": { "type": "boolean", "description": "score is inside scoring_rules.escalation band (Auto mode sends it to Cloud)." },
    "headline": { "$ref": "#/$defs/i18n" },
    "red_flags": { "type": "array", "items": { "$ref": "#/$defs/red_flag" } },
    "brand": {
      "type": "object",
      "properties": {
        "claimed": { "type": ["string", "null"] },
        "official_domains": { "type": "array", "items": { "type": "string" } },
        "matches": { "type": ["boolean", "null"], "description": "null when the brand is not in brand_domains.json (model opinion only)." }
      },
      "required": ["claimed", "official_domains", "matches"],
      "additionalProperties": false
    },
    "signals": {
      "type": "object",
      "properties": {
        "domain_age_days": { "type": ["integer", "null"] },
        "tls_issuer": { "type": ["string", "null"] },
        "cert_age_days": { "type": ["integer", "null"] },
        "safe_browsing": { "type": "string", "enum": ["hit", "no_match", "unknown"] },
        "redirect_count": { "type": "integer", "minimum": 0 },
        "punycode": { "type": "boolean" },
        "homoglyph": { "type": "boolean" },
        "forms": { "type": "array", "items": { "$ref": "#/$defs/form_signal" } },
        "external_link_domains": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["domain_age_days", "tls_issuer", "cert_age_days", "safe_browsing", "redirect_count", "punycode", "homoglyph", "forms"],
      "additionalProperties": false
    },
    "features": {
      "description": "Lite: lite_features.schema.json. Cloud: cloud_features.schema.json. null when the model step timed out/failed.",
      "anyOf": [
        { "$ref": "lite_features.schema.json" },
        { "$ref": "cloud_features.schema.json" },
        { "type": "null" }
      ]
    },
    "cloaking": {
      "type": "object",
      "properties": {
        "suspected": { "type": "boolean" },
        "detail": { "type": ["string", "null"] }
      },
      "required": ["suspected", "detail"],
      "additionalProperties": false
    },
    "trace": { "type": "array", "items": { "$ref": "#/$defs/trace_step" } },
    "engine": {
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "runtime": { "type": "string" },
        "think": { "type": "boolean" }
      },
      "required": ["model", "runtime", "think"],
      "additionalProperties": false
    },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["schema_version", "id", "mode", "status", "url", "final_url", "registrable_domain", "score", "level", "escalate", "headline", "red_flags", "brand", "signals", "features", "cloaking", "trace", "engine", "latency_ms", "created_at"],
  "additionalProperties": false
}
