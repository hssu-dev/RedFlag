{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redflag.dev/contracts/lite_features.schema.json",
  "title": "LiteFeatures",
  "description": "The 10 fixed fields Gemma (RedFlag-Lite) returns. Mirrors redflag-gemma-test/system_prompt*.txt and run_eval.py (KEYS/ENUMS/ACTIONS). The model never scores; the rule engine does.",
  "type": "object",
  "properties": {
    "evidence": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 3,
      "description": "Verbatim snippets from untrusted_page."
    },
    "claimed_brand": { "type": ["string", "null"] },
    "brand_matches_domain": { "type": "string", "enum": ["yes", "no", "unclear", "no_brand"] },
    "page_type": { "type": "string", "enum": ["login", "payment", "shop", "download", "support", "info", "other"] },
    "requested_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["enter_password", "enter_card", "enter_personal_id", "enter_secret_code", "enter_contact_info", "pay_fee", "call_phone", "install_app", "connect_wallet", "none"]
      }
    },
    "urgency_or_threat": { "type": "boolean" },
    "too_good_to_be_true": { "type": "boolean" },
    "addresses_ai_analyzer": { "type": "boolean" },
    "verdict": { "type": "string", "enum": ["safe", "suspicious", "malicious"] },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
  },
  "required": ["evidence", "claimed_brand", "brand_matches_domain", "page_type", "requested_actions", "urgency_or_threat", "too_good_to_be_true", "addresses_ai_analyzer", "verdict", "confidence"],
  "additionalProperties": false
}
